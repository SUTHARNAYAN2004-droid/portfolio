{
  "version": 2,
  "builds": [
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.svg",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/style.css",   "dest": "/style.css" },
    { "src": "/script.js",   "dest": "/script.js" },
    { "src": "/favicon.svg", "dest": "/favicon.svg" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/(.*)",        "dest": "/server.js" }
  ]
}
